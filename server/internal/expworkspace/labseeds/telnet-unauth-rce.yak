address = cli.String(
    "address",
    cli.setDefault("argus-exp-telnet:23"),
    cli.setVerboseName("Telnet 实验靶机"),
    cli.setInputType("host_port"),
)
marker = cli.String(
    "marker",
    cli.setDefault(""),
    cli.setVerboseName("Fixture 标记覆写值"),
    cli.setHelp("留空时由 EXP 为本次命令生成；仅离线 Fixture 或定向调试需要覆写"),
)

cli.check()

if marker == "" {
    marker = "ARGUS_TELNET_" + codec.EncodeToHex(codec.CryptoRandBytes(12))
}

if address != "argus-exp-telnet:23" {
    panic("lab EXP only accepts the isolated Telnet container")
}
marker_ok, marker_err = yaksha.regexMatch("^[A-Za-z0-9_-]{12,64}$", marker)
if marker_err != nil || !marker_ok {
    panic("invalid marker")
}

command = "id; echo " + marker + "; exit\n"
exchange, exchange_err = yaksha.tcpExchange({
    "address": address,
    "max_response_bytes": 65536,
    "steps": [
        {"operation": "read", "until": "# ", "max_bytes": 512, "idle_timeout_ms": 3000},
        {"operation": "write", "data": command, "encoding": "utf8", "idle_timeout_ms": 2000},
        {"operation": "read", "until": marker + "\r\n", "max_bytes": 32768, "idle_timeout_ms": 5000},
    ],
})
if exchange_err != nil { panic(exchange_err) }
output = exchange["responses"][1]
identity_found, identity_err = yaksha.regexMatch("uid=[0-9]+\\([^)]*\\)", output)
marker_found, marker_match_err = yaksha.regexMatch(marker, output)
if identity_err != nil || marker_match_err != nil || !identity_found || !marker_found {
    panic("Telnet command output did not contain identity and marker")
}

yaksha.evidence("identity_found", true)
yaksha.evidence("marker_found", true)
yaksha.result({
    "vulnerable": true,
    "service": "telnet",
    "remote_address": exchange["remote_address"],
    "output": output,
})
