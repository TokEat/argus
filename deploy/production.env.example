# Argus v0.1.0 production environment template
#
# Copy this file to your secret manager or deployment environment and replace
# every CHANGE_ME value before running a production service. The one-shot
# setup script can also receive the most important secrets through CLI flags.

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
ARGUS_DB_DSN=host=127.0.0.1 user=postgres password=CHANGE_ME_STRONG_DB_PASSWORD dbname=argus port=5432 sslmode=disable

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=argus
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
ARGUS_AMQP_URL=amqp://argus:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@127.0.0.1:5672/

# Private MinIO for immutable Yaksha EXP sources, Assets and run artifacts.
# The Server credential is a bucket-scoped application user, not the root user.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
ARGUS_EXP_STORE_MODE=minio
ARGUS_EXP_MINIO_ENDPOINT=http://127.0.0.1:9000
ARGUS_EXP_MINIO_REGION=us-east-1
ARGUS_EXP_MINIO_BUCKET=argus-exp
ARGUS_EXP_MINIO_ACCESS_KEY=CHANGE_ME_EXP_APP_ACCESS_KEY
ARGUS_EXP_MINIO_SECRET_KEY=CHANGE_ME_STRONG_EXP_APP_SECRET_KEY
ARGUS_EXP_MINIO_USE_SSL=false
ARGUS_EXP_TRACE_RETENTION=168h
ARGUS_YAKSHA_URL=http://127.0.0.1:8790

# Server ports
ARGUS_HTTP_ADDR=:8085
ARGUS_GRPC_ADDR=:50051
ARGUS_GRPC_TLS_PORT=50053
ARGUS_GRPC_TLS_CERT=/etc/argus/tls/agent-server.crt
ARGUS_GRPC_TLS_KEY=/etc/argus/tls/agent-server.key
ARGUS_PUBLIC_IP=CHANGE_ME_PUBLIC_IP

# Credential-capable Agents must use the TLS listener and verify this CA.
ARGUS_AGENT_GRPC_CA=/etc/argus/tls/agent-ca.crt
ARGUS_AGENT_GRPC_SERVER_NAME=argus-agent-gateway.example.internal

# Required secrets
ARGUS_AGENT_PSK=CHANGE_ME_HEX_32_BYTES_OR_LONG_RANDOM
ARGUS_JWT_SECRET=CHANGE_ME_HEX_32_BYTES_OR_LONG_RANDOM
ARGUS_ENCRYPT_KEY=CHANGE_ME_32_BYTE_BASE64_OR_HEX_KEY
# Dedicated AEAD key for project dictionaries, one-time credential bundles,
# and successful credential evidence. Never reuse ARGUS_ENCRYPT_KEY here.
ARGUS_CREDENTIAL_ENCRYPT_KEY=CHANGE_ME_DIFFERENT_32_BYTE_BASE64_OR_RAW_KEY

# Private Yaksha -> Server Agent egress gateway. Do not publish this listener.
ARGUS_EGRESS_GATEWAY_LISTEN=127.0.0.1:50052
ARGUS_EGRESS_GATEWAY_TOKEN=CHANGE_ME_HEX_32_BYTES_OR_LONG_RANDOM
YAKSHA_RELAY_ADDR=127.0.0.1:50052
YAKSHA_RELAY_TOKEN=CHANGE_ME_SAME_VALUE_AS_ARGUS_EGRESS_GATEWAY_TOKEN

# Required for MCP HTTP/SSE transport; keep separate from the Server API token.
ARGUS_MCP_AUTH_TOKEN=CHANGE_ME_HEX_32_BYTES_OR_LONG_RANDOM

# Initial administrator
ARGUS_ADMIN_USERNAME=admin
ARGUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Optional AI providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional cloud providers. CloudManagement and OSS autoscaling are beta until
# a real cloud-account smoke test is recorded for the release.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
