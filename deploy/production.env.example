# Argus v0.1.0 production environment template
#
# Copy this file to your secret manager or deployment environment and replace
# every CHANGE_ME value before running a production service. The one-shot
# setup script can also receive the most important secrets through CLI flags.

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
ARGUS_DB_DSN=host=127.0.0.1 user=postgres password=CHANGE_ME_STRONG_DB_PASSWORD dbname=argus port=5432 sslmode=disable

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=argus
RABBITMQ_DEFAULT_PASS=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
ARGUS_AMQP_URL=amqp://argus:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@127.0.0.1:5672/

# Server ports
ARGUS_HTTP_ADDR=:8085
ARGUS_GRPC_ADDR=:50051
ARGUS_PUBLIC_IP=CHANGE_ME_PUBLIC_IP

# Required secrets
ARGUS_AGENT_PSK=CHANGE_ME_HEX_32_BYTES_OR_LONG_RANDOM
ARGUS_JWT_SECRET=CHANGE_ME_HEX_32_BYTES_OR_LONG_RANDOM
ARGUS_ENCRYPT_KEY=CHANGE_ME_32_BYTE_BASE64_OR_HEX_KEY

# Initial administrator
ARGUS_ADMIN_USERNAME=admin
ARGUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Optional AI providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional cloud providers. CloudManagement and OSS autoscaling are beta until
# a real cloud-account smoke test is recorded for the release.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
